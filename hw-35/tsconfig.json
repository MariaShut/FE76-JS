{
  "compilerOptions": {
    // На какой стандарт JS компилировать (современные фичи доступны)
    "target": "ES2020",
    // Какой модульный формат использовать (импорт/экспорт)
    "module": "ESNext",
    // Как искать модули (для современных сборщиков, например Parcel)
    "moduleResolution": "bundler",
    // Включает строгую проверку типов (лучше ловит ошибки)
    "strict": true,
    // Не создавать выходные файлы .js (полезно при сборке через Parcel)
    "noEmit": true,
    // Проверять каждый файл как отдельный модуль (требуется для сборщиков)
    "isolatedModules": true,
    // Не проверять типы внутри node_modules (ускоряет сборку)
    "skipLibCheck": true,
    // Поддержка импортов CommonJS модулей через import
    "esModuleInterop": true,
    // Следить за регистром в именах файлов (важно для Linux/Windows)
    "forceConsistentCasingInFileNames": true
  },
  // Какие файлы включать в проект
  "include": ["./**/*.ts"]
}
